---
import type { CollectionEntry } from "astro:content";

import { profile } from "../data/profile";
import { authorListHtml } from "../lib/authors";
import { publicationFragmentId } from "../lib/structured-data";
import { formatBehavioralDate } from "../lib/dates";
import { availableExternalLinks } from "../lib/external-links";

export interface Props {
  publications: CollectionEntry<"publications">[];
}

const { publications } = Astro.props;
---

<ol class="publication-list" aria-label="Publications and presentations">
  {
    publications.map((publication) => {
      const links = availableExternalLinks(publication.data.links);
      const titleHref = publication.data.links?.doi ?? links[0]?.href;
      const showStatus =
        publication.data.status.trim().toLowerCase() !== "published";
      const formattedDate = formatBehavioralDate(
        publication.data.date,
        publication.data.datePrecision,
      );

      return (
        <li id={publicationFragmentId(publication.id)} class="publication-item">
          <p class="publication-title">
            <cite>
              {titleHref ? (
                <a href={titleHref}>{publication.data.title}</a>
              ) : (
                publication.data.title
              )}
            </cite>
          </p>
          <p
            class="publication-authors"
            set:html={authorListHtml(
              publication.data.authors,
              profile.authorNames,
            )}
          />
          <p class="publication-meta">
            {publication.data.venue && (
              <>
                <em>{publication.data.venue}</em>
                <span aria-hidden="true"> · </span>
              </>
            )}
            <time datetime={formattedDate.datetime}>
              {formattedDate.visible}
            </time>
            {showStatus && (
              <>
                <span aria-hidden="true"> · </span>
                {publication.data.status}
              </>
            )}
          </p>
          {links.length > 0 && (
            <ul
              class="link-chips"
              aria-label={`Links for ${publication.data.title}`}
            >
              {links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })
  }
</ol>

<style>
  .publication-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .publication-item + .publication-item {
    margin-block-start: var(--space-m);
  }

  .publication-title {
    font-weight: 640;
    line-height: 1.35;
  }

  cite {
    font-style: normal;
  }

  .publication-title a {
    text-decoration: none;
  }

  .publication-title a:hover {
    text-decoration: underline;
  }

  .publication-authors {
    margin-block-start: 0.15rem;
    color: var(--ink);
    font-size: var(--step--1);
  }

  .publication-meta {
    color: var(--ink-muted);
    font-size: var(--step--1);
  }
</style>
